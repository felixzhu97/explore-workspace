{
  "name": "chat-server",
  "tags": ["scope:chat", "type:app"],
  "targets": {
    "serve": {
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["kafka"],
          "target": "serve",
          "waitFor": "ready"
        },
        {
          "projects": ["ollama"],
          "target": "serve"
        }
      ],
      "readyWhen": { "url": "http://localhost:9001/actuator/health" },
      "command": "./gradlew :chat-server:bootRun",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    }
  }
}