{
  "name": "explore-commerce",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "server"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=admin",
    "build:api": "turbo run build --filter=server",
    "build:mobile": "turbo run build --filter=react-native-app",
    "build:web": "turbo run build --filter=web",
    "changeset": "changeset",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:api": "turbo run clean --filter=server",
    "clean:mobile": "turbo run clean --filter=react-native-app",
    "clean:web": "turbo run clean --filter=web",
    "dev": "turbo run dev --concurrency=12",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:api": "turbo run dev --filter=server",
    "dev:api-web": "turbo run dev --filter=server --filter=web --concurrency=3",
    "dev:meeting-signal": "turbo run dev --filter=meeting-signal",
    "dev:mobile": "turbo run start --filter=react-native-app",
    "dev:server": "bash scripts/server/start-server.sh",
    "dev:web": "turbo run dev --filter=web",
    "dev:web:storybook": "turbo run storybook --filter=web",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "node -e \"process.exit(0)\"",
    "lint:api": "turbo run lint --filter=server",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:mobile": "turbo run lint --filter=react-native-app",
    "lint:web": "turbo run lint --filter=web",
    "publish": "turbo run build && changeset publish",
    "seed:api": "pnpm --filter scripts run seed:products200:dev",
    "seed:default-users": "pnpm --filter scripts run seed:default-users:dev",
    "seed:orders-users": "pnpm --filter scripts run seed:orders-users:dev",
    "start": "turbo run start",
    "start:api": "turbo run start --filter=server",
    "start:crawler": "cd services/crawler && uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "start:web": "turbo run start --filter=web",
    "test": "turbo run test",
    "test:api": "turbo run test --filter=server",
    "test:coverage": "turbo run test:coverage",
    "test:mobile": "turbo run test --filter=react-native-app",
    "test:watch": "turbo run test:watch",
    "test:web": "turbo run test --filter=web",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "turbo": "^2.7.5",
    "typescript": "^5",
    "typescript-eslint": "8.59.4",
    "vitest": "^1.4.0"
  },
  "engines": {
    "pnpm": ">=10.1.0",
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.10.1",
    "@octokit/rest": "21.1.1",
    "@smithery/sdk": "1.0.4"
  }
}
