{
  "name": "explore-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev:admin": "pnpm --filter portfolio-admin dev",
    "dev:portal": "pnpm --filter portfolio-portal dev",
    "dev:mobile": "pnpm --filter portfolio-mobile start",
    "dev:mobile:ios": "pnpm --filter portfolio-mobile ios",
    "dev:mobile:android": "pnpm --filter portfolio-mobile android",
    "dev:server": "bash scripts/backend/start-backend.sh",
    "build": "turbo run build",
    "check-types": "pnpm -r run --if-present check-types",
    "tsc": "pnpm -r run --if-present check-types",
    "start": "pnpm --filter portfolio-admin start",
    "test": "pnpm run test:api",
    "test:all": "pnpm -r --parallel run test",
    "test:all:coverage": "pnpm -r --parallel run test:coverage",
    "test:type": "pnpm -r --parallel run type-check",
    "test:api": "cd analytics && .venv/bin/python -m pytest tests -v",
    "lint": "node -e \"process.exit(0)\"",
    "pre-commit": "pnpm check-types && pnpm test:type && pnpm test:all && pnpm lint",
    "stop:backend": "bash scripts/backend/stop-backend.sh",
    "generate-seed-data": "tsx scripts/seed/generate-seed-data.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.0",
    "tsx": "^4.23.12",
    "turbo": "^2.5.4",
    "typescript": "^5"
  }
}
