{
  "name": "iam-console",
  "version": "0.0.1",
  "private": true,
  "description": "Explore IAM \u2014 shared identity and OIDC for Explore products",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201 --host 127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/animations": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-browser-dynamic": "22.1.6",
    "@angular/router": "22.1.6",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.6.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "~6.0.3"
  },
  "nx": {
    "tags": [
      "scope:iam"
    ],
    "targets": {
      "serve": {
        "continuous": true,
        "command": "ng serve --port 4201 --host 127.0.0.1",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
