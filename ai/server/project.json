{
  "name": "ai-server",
  "tags": ["scope:ai"],
  "targets": {
    "serve": {
      "continuous": true,
      "dependsOn": [
        { "projects": ["ollama"], "target": "serve" },
        { "projects": ["iam-server"], "target": "serve", "waitFor": "ready" }
      ],
      "readyWhen": { "url": "http://localhost:9000/actuator/health" },
      "command": "./gradlew :ai-server:bootRun",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
