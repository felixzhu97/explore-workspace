{
  "name": "ai-web",
  "version": "0.0.1",
  "private": true,
  "description": "Demo / learning platform for conversational AI built with Spring AI and Angular: Chat, RAG, tool calling, and quality evaluation.",
  "keywords": [
    "java",
    "spring-boot",
    "spring-ai",
    "angular",
    "typescript",
    "gradle",
    "rag",
    "llm",
    "embeddings",
    "vector-database",
    "ollama",
    "deepseek",
    "tool-calling",
    "mcp",
    "onnx",
    "computer-vision",
    "speech-recognition",
    "llm-evaluation",
    "demo"
  ],
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build": "node scripts/inject-datadog-env.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "clean": "rm -rf dist .angular node_modules/.cache",
    "vision:verify": "../server/scripts/verify-vision.sh all",
    "vision:models": "../server/scripts/download-vision-models.sh",
    "server:test": "../../gradlew :ai-server:test",
    "server:test:watch": "../../gradlew :ai-server:test --continuous",
    "server:test:coverage": "../../gradlew :ai-server:test :ai-server:jacocoTestReport"
  },
  "dependencies": {
    "@a2ui/angular": "^0.14.0",
    "@a2ui/web_core": "^0.15.0",
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@ant-design/icons-angular": "^22.1.0",
    "@datadog/browser-rum": "^7.17.1",
    "@floating-ui/dom": "^1.8.0",
    "@foblex/flow": "^19.4.0",
    "@js-joda/core": "^6.3.2",
    "@launchdarkly/js-client-sdk": "^4.14.2",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "nanoid": "^6.0.2",
    "ng-zorro-antd": "^22.2.0",
    "ng-zorro-x": "0.6.0-alpha.1",
    "ngx-echarts": "^22.0.0",
    "ngx-sonner": "^3.1.0",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@analogjs/vitest-angular": "^2.9.6",
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.1",
    "@vitest/browser": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^31.0.0",
    "sass-embedded": "^1.108.2",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.0",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.1",
    "zard-cli": "1.5.1"
  },
  "nx": {
    "tags": [
      "scope:ai"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "DD_APPLICATION_ID"
          },
          {
            "env": "DD_CLIENT_TOKEN"
          },
          {
            "env": "DD_SITE"
          },
          {
            "env": "DD_SERVICE"
          },
          {
            "env": "DD_ENV"
          }
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "serve": {
        "continuous": true,
        "dependsOn": [
          {
            "projects": [
              "ai-server"
            ],
            "target": "serve",
            "waitFor": "ready"
          }
        ],
        "command": "ng serve --port 4200",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
