{
  "name": "ml-web",
  "tags": ["scope:ml", "type:app"],
  "targets": {
    "serve": {
      "continuous": true,
      "dependsOn": [{ "projects": ["ml-server"], "target": "serve", "waitFor": "ready" }],
      "command": "npx ng serve --host 0.0.0.0 --port 4210",
      "options": { "cwd": "{projectRoot}" }
    }
  }
}
