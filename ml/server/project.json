{
  "name": "ml-server",
  "tags": ["scope:ml", "type:app"],
  "targets": {
    "serve": {
      "continuous": true,
      "readyWhen": { "url": "http://localhost:8000/health" },
      "command": "uv run uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "options": { "cwd": "{projectRoot}" }
    }
  }
}
