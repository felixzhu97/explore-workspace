@startuml C4-Code-Domain-Model-Integration-Relations
!include ../../c4-model/style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

skinparam package<<System>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package<<Bounded Context>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
hide members

title 系统对接关系 — Explore Three

legend right
  |= 包 / Stereotype |= 中文术语 |
  | System | 系统 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | 同上下文 | 实线 / 组合 |
  | 跨上下文 / 跨系统 | 虚线 |
endlegend

package "探索 Three\nExplore Three" <<System>> {
  package "Core Domain\n核心领域" <<Bounded Context>> {
    class SpherePoint as "SpherePoint\n球面点" <<Entity>>
    class GeoCoord as "GeoCoord\n地理坐标" <<Entity>>
    class GeographyService as "GeographyService\n地理服务" <<Entity>>
    class FlightRoute as "FlightRoute\n飞行航线" <<Entity>>
    class RouteService as "RouteService\n航线服务" <<Entity>>
    class ThemeId as "ThemeId\n主题标识" <<Entity>>
    class RouteColor as "RouteColor\n航线颜色" <<Entity>>
    class ThemeAppearance as "ThemeAppearance\n主题外观" <<Entity>>
  }
  package "Integration Config\n对接配置" <<Bounded Context>> {
    class IntegrationConfig as "IntegrationConfig\n对接配置" <<Aggregate Root>>
  }
}

package "Vercel" <<System>> {
  class vercel_Facade as "Vercel\n对接门面" <<Aggregate Root>>
}

package "Static Assets" <<System>> {
  class assets_Facade as "Static Assets\n对接门面" <<Aggregate Root>>
}

IntegrationConfig --> SpherePoint : 配置 / configures
SpherePoint ..> vercel_Facade : 对接 / integrate
SpherePoint ..> assets_Facade : 对接 / integrate

@enduml
