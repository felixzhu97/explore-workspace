@startuml C4-Code-Domain-Model
!include ../../c4-model/style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}


title 领域模型 — Explore Lowcode

legend right
  |= Stereotype |= 中文术语 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | Domain Event | 领域事件 |
  | Domain Service | 领域服务 |
  | Repository | 仓储 |
  | Abstract | 抽象 |
  | Enum | 枚举 |
  | System | 系统 |
  | Service | 应用服务 |
endlegend

package "Core\n核心" <<Bounded Context>> {
  class Page as "Page\n页面" <<Aggregate Root>> {
    + 标识 (id)
    --
    + 行为() (act())
  }
  class Component as "Component\n组件" <<Entity>> {
    + 标识 (id)
    --
    + 行为() (act())
  }
  class Theme as "Theme\n主题" <<Value Object>> {
    + 标识 (id)
    --
    + 行为() (act())
  }
  class Template as "Template\n模板" <<Aggregate Root>> {
    + 标识 (id)
    --
    + 行为() (act())
  }
  class DataSource as "DataSource\n数据源" <<Entity>> {
    + 标识 (id)
    --
    + 行为() (act())
  }
}

Page "1" *-- "0..*" Component
Page "0..*" --> "0..1" Theme
Template "0..*" --> "0..*" Page
Component "0..*" --> "0..1" DataSource

@enduml
