@startuml C4-Code-Domain-Model-Integration-Relations
!include ../../c4-model/style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

skinparam package<<System>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package<<Bounded Context>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
hide members

title 系统对接关系 — Explore Portfolio

legend right
  |= 包 / Stereotype |= 中文术语 |
  | System | 系统 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | 同上下文 | 实线 / 组合 |
  | 跨上下文 / 跨系统 | 虚线 |
endlegend

package "探索 Portfolio\nExplore Portfolio" <<System>> {
  package "Core Domain\n核心领域" <<Bounded Context>> {
    class AbstractEmbeddable as "AbstractEmbeddable\n抽象可嵌入类型" <<Entity>>
    class TypedId as "TypedId\n类型化标识" <<Entity>>
    class AbstractImmutable as "AbstractImmutable\n抽象不可变类型" <<Entity>>
    class AbstractEntity as "AbstractEntity\n抽象实体" <<Entity>>
    class Money as "Money\n金额" <<Entity>>
    class CurrencyCode as "CurrencyCode\n币种代码" <<Entity>>
    class Symbol as "Symbol\n交易代码" <<Entity>>
    class Quantity as "Quantity\n数量" <<Entity>>
  }
  package "Integration Config\n对接配置" <<Bounded Context>> {
    class IntegrationConfig as "IntegrationConfig\n对接配置" <<Aggregate Root>>
  }
}

package "Market Data Providers" <<System>> {
  class market_feed_Facade as "Market Data Providers\n对接门面" <<Aggregate Root>>
}

package "Ethereum Sepolia" <<System>> {
  class eth_testnet_Facade as "Ethereum Sepolia\n对接门面" <<Aggregate Root>>
}

package "Primary Database" <<System>> {
  class db_Facade as "Primary Database\n对接门面" <<Aggregate Root>>
}

IntegrationConfig --> AbstractEmbeddable : 配置 / configures
AbstractEmbeddable ..> market_feed_Facade : 对接 / integrate
AbstractEmbeddable ..> eth_testnet_Facade : 对接 / integrate
AbstractEmbeddable ..> db_Facade : 对接 / integrate

@enduml
