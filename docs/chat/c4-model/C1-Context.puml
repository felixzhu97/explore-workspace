@startuml
!ROUNDED_STYLE=0
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include ../../c4-model/style-c4.puml
LAYOUT_WITH_LEGEND()
title 系统上下文 — Chat

Person(user_web, "Web 用户", "浏览器：信息流、聊天、通话、探索")
Person(user_mobile, "移动端用户", "Expo / SwiftUI：信息流、Reels、聊天、通话；可走 IAM SSO")
Person(admin_user, "管理员", "运营后台：用户、内容与配置")

System(chat, "Chat", "社交 + 即时通讯：Feed、帖子、评论、关注、聊天、音视频、搜索、通知；Spring API 边界")

System_Ext(explore_iam, "Explore IAM", "OIDC IdP：authorize / token / JWKS；native PKCE")
System_Ext(email, "邮件服务", "事务邮件（SMTP / SES）")
System_Ext(push, "推送服务", "FCM / APNs")
System_Ext(storage, "文件存储", "本地盘或对象存储媒体")
System_Ext(webrtc, "STUN / TURN", "WebRTC NAT 穿透")
System_Ext(explore_ai, "Explore AI", "可选：经 Spring BFF 代理")

Rel(user_web, chat, "使用", "HTTPS / WebSocket / WebRTC")
Rel(user_mobile, chat, "使用", "HTTPS / WebSocket / WebRTC")
Rel(user_mobile, explore_iam, "登录 / 同意", "OIDC / PKCE")
Rel(admin_user, chat, "管理", "HTTPS")
Rel(chat, explore_iam, "校验 IAM JWT / JWKS", "HTTPS")
Rel(chat, email, "发送邮件", "SMTP")
Rel(chat, push, "发送推送", "HTTPS")
Rel(chat, storage, "存取媒体", "HTTPS / 本地 FS")
Rel(chat, webrtc, "媒体中继", "UDP / TCP")
Rel(chat, explore_ai, "服务间调用", "HTTPS + X-Service-Key")

SHOW_LEGEND()
@enduml
