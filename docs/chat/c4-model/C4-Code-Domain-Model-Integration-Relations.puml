@startuml C4-Code-Domain-Model-Integration-Relations
!include ../../c4-model/style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

skinparam package<<System>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package<<Bounded Context>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
hide members

title 系统对接关系 — Explore Chat

legend right
  |= 包 / Stereotype |= 中文术语 |
  | System | 系统 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | 同上下文 | 实线 / 组合 |
  | 跨上下文 / 跨系统 | 虚线 |
endlegend

package "探索 Chat\nExplore Chat" <<System>> {
  package "Core Domain\n核心领域" <<Bounded Context>> {
    class AuthTokens <<Entity>>
    class User as "User\n用户" <<Entity>>
    class UserFollow <<Entity>>
    class Chat as "Chat\n聊天" <<Entity>>
    class ChatParticipant <<Entity>>
    class SpringDataChatRepository <<Entity>>
    class SpringDataChatParticipantRepository <<Entity>>
    class Message as "Message\n消息" <<Entity>>
  }
  package "Integration Config\n对接配置" <<Bounded Context>> {
    class IntegrationConfig as "IntegrationConfig\n对接配置" <<Aggregate Root>>
  }
}

package "Explore IAM" <<System>> {
  class explore_iam_Facade as "Explore IAM\n对接门面" <<Aggregate Root>>
}

package "邮件服务" <<System>> {
  class email_Facade as "邮件服务\n对接门面" <<Aggregate Root>>
}

package "推送服务" <<System>> {
  class push_Facade as "推送服务\n对接门面" <<Aggregate Root>>
}

package "文件存储" <<System>> {
  class storage_Facade as "文件存储\n对接门面" <<Aggregate Root>>
}

package "STUN / TURN" <<System>> {
  class webrtc_Facade as "STUN / TURN\n对接门面" <<Aggregate Root>>
}

package "Explore AI" <<System>> {
  class explore_ai_Facade as "Explore AI\n对接门面" <<Aggregate Root>>
}

IntegrationConfig --> AuthTokens : 配置 / configures
AuthTokens ..> explore_iam_Facade : 对接 / integrate
AuthTokens ..> email_Facade : 对接 / integrate
AuthTokens ..> push_Facade : 对接 / integrate
AuthTokens ..> storage_Facade : 对接 / integrate
AuthTokens ..> webrtc_Facade : 对接 / integrate
AuthTokens ..> explore_ai_Facade : 对接 / integrate

@enduml
