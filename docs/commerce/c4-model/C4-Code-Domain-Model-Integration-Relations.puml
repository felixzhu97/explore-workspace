@startuml C4-Code-Domain-Model-Integration-Relations
!include ../../c4-model/style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

skinparam package<<System>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package<<Bounded Context>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
hide members

title 系统对接关系 — Explore Commerce

legend right
  |= 包 / Stereotype |= 中文术语 |
  | System | 系统 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | 同上下文 | 实线 / 组合 |
  | 跨上下文 / 跨系统 | 虚线 |
endlegend

package "探索 Commerce\nExplore Commerce" <<System>> {
  package "Core Domain\n核心领域" <<Bounded Context>> {
    class Order as "Order\n订单" <<Entity>>
    class OrderLine as "OrderLine\n订单明细" <<Entity>>
    class Cart as "Cart\n购物车" <<Entity>>
    class Product as "Product\n商品" <<Entity>>
    class PaymentIntent as "PaymentIntent\n支付意图" <<Entity>>
    class Customer as "Customer\n客户" <<Entity>>
  }
  package "Integration Config\n对接配置" <<Bounded Context>> {
    class IntegrationConfig as "IntegrationConfig\n对接配置" <<Aggregate Root>>
  }
}

package "支付网关" <<System>> {
  class payment_gateway_Facade as "支付网关\n对接门面" <<Aggregate Root>>
}

package "OAuth服务商" <<System>> {
  class oauth_providers_Facade as "OAuth服务商\n对接门面" <<Aggregate Root>>
}

package "Stripe" <<System>> {
  class stripe_payment_Facade as "Stripe\n对接门面" <<Aggregate Root>>
}

IntegrationConfig --> Order : 配置 / configures
Order ..> payment_gateway_Facade : 对接 / integrate
Order ..> oauth_providers_Facade : 对接 / integrate
Order ..> stripe_payment_Facade : 对接 / integrate

@enduml
