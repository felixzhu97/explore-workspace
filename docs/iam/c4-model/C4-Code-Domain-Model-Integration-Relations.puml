@startuml C4-Code-Domain-Model-Integration-Relations
!include ../../c4-model/style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

skinparam package<<System>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package<<Bounded Context>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
hide members

title 系统对接关系 — Explore IAM

legend right
  |= 包 / Stereotype |= 中文术语 |
  | System | 系统 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | 同上下文 | 实线 / 组合 |
  | 跨上下文 / 跨系统 | 虚线 |
endlegend

package "探索 IAM\nExplore IAM" <<System>> {
  package "Core Domain\n核心领域" <<Bounded Context>> {
    class AbstractImmutableEntity as "AbstractImmutableEntity\n抽象不可变实体" <<Entity>>
    class AbstractEntity as "AbstractEntity\n抽象实体" <<Entity>>
    class AbstractEmbeddable as "AbstractEmbeddable\n抽象可嵌入类型" <<Entity>>
    class AbstractNamedEntity <<Entity>>
    class AbstractAuditEvent <<Entity>>
    class DomainStrings <<Entity>>
    class ResourceName <<Entity>>
    class Resource <<Entity>>
  }
  package "Integration Config\n对接配置" <<Bounded Context>> {
    class IntegrationConfig as "IntegrationConfig\n对接配置" <<Aggregate Root>>
  }
}

package "Google IdP" <<System>> {
  class google_idp_Facade as "Google IdP\n对接门面" <<Aggregate Root>>
}

package "GitHub IdP" <<System>> {
  class github_idp_Facade as "GitHub IdP\n对接门面" <<Aggregate Root>>
}

package "Enterprise IdP" <<System>> {
  class enterprise_idp_Facade as "Enterprise IdP\n对接门面" <<Aggregate Root>>
}

package "Explore AI" <<System>> {
  class explore_ai_Facade as "Explore AI\n对接门面" <<Aggregate Root>>
}

package "Explore Chat" <<System>> {
  class explore_chat_Facade as "Explore Chat\n对接门面" <<Aggregate Root>>
}

package "Shopping System" <<System>> {
  class shopping_Facade as "Shopping System\n对接门面" <<Aggregate Root>>
}

package "Low Code Platform" <<System>> {
  class low_code_Facade as "Low Code Platform\n对接门面" <<Aggregate Root>>
}

IntegrationConfig --> AbstractImmutableEntity : 配置 / configures
AbstractImmutableEntity ..> google_idp_Facade : 对接 / integrate
AbstractImmutableEntity ..> github_idp_Facade : 对接 / integrate
AbstractImmutableEntity ..> enterprise_idp_Facade : 对接 / integrate
AbstractImmutableEntity ..> explore_ai_Facade : 对接 / integrate
AbstractImmutableEntity ..> explore_chat_Facade : 对接 / integrate
AbstractImmutableEntity ..> shopping_Facade : 对接 / integrate
AbstractImmutableEntity ..> low_code_Facade : 对接 / integrate

@enduml
