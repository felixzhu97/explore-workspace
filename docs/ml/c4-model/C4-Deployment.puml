@startuml
!ROUNDED_STYLE=0
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
!include ../../c4-model/style-c4.puml
LAYOUT_WITH_LEGEND()
title 部署图 — Explore ML（本地）

Deployment_Node(dev_machine, "Dev machine", "macOS / Linux") {
  Deployment_Node(py_app, "server (venv, one uvicorn)", "Python 3.12") {
    Container(app, "ML app", "FastAPI", ":8000; recommendation, vision, rag, image_playground, speech, video")
    ContainerDb(qdrant, "Qdrant (embedded)", "Files", "server/rag/data/qdrant; or a remote QDRANT_URL")
  }
  Deployment_Node(ollama_node, "Ollama", ":11434") {
    Container(ollama, "Ollama", "LLM runtime", "Embedding + chat models")
  }
  Deployment_Node(weights_node, "~/Codes/models", "LOCAL_MODELS_ROOT, outside the repo") {
    ContainerDb(weights, "Model weights", "Files", "asr, tts, image, rerank, recommendation, fine-tuned outputs")
  }
  Deployment_Node(data_node, "data/", "in git") {
    ContainerDb(fixtures, "Fixtures", "JSONL", "data/finetune/* small eval and training sets")
  }
  Deployment_Node(ui_node, ":web/ (Node 22)", "ng serve :4210") {
    Container(ui, "Model Test UI", "Angular", "Proxies /ml to :8000")
  }
}

Rel(ui, app, "/ml", "HTTP + SSE + WS")
Rel(app, qdrant, "embedded client")
Rel(app, ollama, "HTTP")
Rel(app, weights, "reads")

SHOW_LEGEND()
@enduml
