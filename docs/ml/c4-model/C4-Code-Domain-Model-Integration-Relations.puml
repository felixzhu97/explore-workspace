@startuml C4-Code-Domain-Model-Integration-Relations
!include ../../c4-model/style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

skinparam package<<System>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package<<Bounded Context>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
hide members

title 系统对接关系 — Explore ML

legend right
  |= 包 / Stereotype |= 中文术语 |
  | System | 系统 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | 同上下文 | 实线 / 组合 |
  | 跨上下文 / 跨系统 | 虚线 |
endlegend

package "探索 ML\nExplore ML" <<System>> {
  package "Core Domain\n核心领域" <<Bounded Context>> {
    class ModelArtifact as "ModelArtifact\n模型制品" <<Entity>>
    class TrainingJob as "TrainingJob\n训练任务" <<Entity>>
    class Dataset as "Dataset\n数据集" <<Entity>>
    class Endpoint as "Endpoint\n推理端点" <<Entity>>
    class OperatorSession as "OperatorSession\n操作会话" <<Entity>>
  }
  package "Integration Config\n对接配置" <<Bounded Context>> {
    class IntegrationConfig as "IntegrationConfig\n对接配置" <<Aggregate Root>>
  }
}

package "Sibling Explore API" <<System>> {
  class sibling_api_Facade as "Sibling Explore API\n对接门面" <<Aggregate Root>>
}

package "Qdrant" <<System>> {
  class vector_db_Facade as "Qdrant\n对接门面" <<Aggregate Root>>
}

package "Ollama / OpenAI" <<System>> {
  class llm_Facade as "Ollama / OpenAI\n对接门面" <<Aggregate Root>>
}

package "Rerank sidecar" <<System>> {
  class reranker_Facade as "Rerank sidecar\n对接门面" <<Aggregate Root>>
}

package "Content API" <<System>> {
  class content_api_Facade as "Content API\n对接门面" <<Aggregate Root>>
}

package "Postgres / Redis / Cassandra" <<System>> {
  class rec_stores_Facade as "Postgres / Redis / Cassandra\n对接门面" <<Aggregate Root>>
}

package "Local model weights" <<System>> {
  class weights_Facade as "Local model weights\n对接门面" <<Aggregate Root>>
}

package "Hugging Face Hub" <<System>> {
  class hub_Facade as "Hugging Face Hub\n对接门面" <<Aggregate Root>>
}

IntegrationConfig --> ModelArtifact : 配置 / configures
ModelArtifact ..> sibling_api_Facade : 对接 / integrate
ModelArtifact ..> vector_db_Facade : 对接 / integrate
ModelArtifact ..> llm_Facade : 对接 / integrate
ModelArtifact ..> reranker_Facade : 对接 / integrate
ModelArtifact ..> content_api_Facade : 对接 / integrate
ModelArtifact ..> rec_stores_Facade : 对接 / integrate
ModelArtifact ..> weights_Facade : 对接 / integrate
ModelArtifact ..> hub_Facade : 对接 / integrate

@enduml
