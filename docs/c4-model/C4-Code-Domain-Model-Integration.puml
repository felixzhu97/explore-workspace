@startuml C4-Code-Domain-Model-Integration
!include style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package<<System>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package<<Bounded Context>> {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

title 系统对接 — Explore Workspace

legend right
  |= 包 / Stereotype |= 中文术语 |
  | System | 系统 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | 同上下文 | 实线 / 组合 |
  | 跨系统 | 虚线；协议见边注 |
endlegend

package "Explore Workspace\n探索工作区" <<System>> {
  package "Integration Config\n对接配置" <<Bounded Context>> {
    class IntegrationConfig as "IntegrationConfig\n对接配置" <<Aggregate Root>> {
      + 启用 (enabled)
      + 端点 (endpoint)
      --
      + 登记接口() (registerInterface())
    }
  }
  package "Identity & Access\n身份与访问" <<Bounded Context>> {
    class FederatedIdentity as "FederatedIdentity\n联邦身份" <<Entity>> {
      + 发行方 (issuer)
      + 主体 (subject)
    }
    class OAuthClient as "OAuthClient\nOAuth 客户端" <<Aggregate Root>> {
      + 客户端标识 (clientId)
    }
    class ProvisioningTarget as "ProvisioningTarget\n供给目标" <<Aggregate Root>> {
      + 端点 (endpoint)
    }
  }
  package "Conversational AI\n对话与智能体" <<Bounded Context>> {
    class ChatSession as "ChatSession\n聊天会话" <<Aggregate Root>> {
      + 所有者 (ownerId)
    }
    class Document as "Document\n文档" <<Aggregate Root>> {
      + 标题 (title)
    }
  }
  package "Commerce\n电商交易" <<Bounded Context>> {
    class PaymentIntent as "PaymentIntent\n支付意图" <<Aggregate Root>> {
      + 金额 (amount)
    }
  }
  package "ML Platform\n机器学习平台" <<Bounded Context>> {
    class ModelArtifact as "ModelArtifact\n模型制品" <<Aggregate Root>> {
      + 名称 (name)
      + 版本 (version)
    }
  }
  package "Wealth\n财富与投组" <<Bounded Context>> {
    class Instrument as "Instrument\n金融工具" <<Aggregate Root>> {
      + 代码 (symbol)
    }
    class TradeOrder as "TradeOrder\n交易订单" <<Aggregate Root>> {
      + 方向 (side)
    }
  }
}

' —— 身份与联邦 ——
package "Google IdP" <<System>> {
  class google_idp_Facade as "Google IdP\n对接门面" <<Aggregate Root>> {
    + 系统名 (systemName)
    + 协议 (protocol)
    --
    + 调用() (invoke())
  }
}

