@startuml C4-Code-Domain-Model
!include style.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
title 领域模型 — Explore Workspace

legend right
  |= Stereotype |= 中文术语 |
  | Bounded Context | 限界上下文 |
  | Aggregate Root | 聚合根 |
  | Entity | 实体 |
  | Value Object | 值对象 |
  | Domain Event | 领域事件 |
  | 跨限界上下文 | 虚线；仅 ID / 事件 / 契约 |
endlegend

package "Identity & Access\n身份与访问" <<Bounded Context>> {
  class User as "User\n用户" <<Aggregate Root>> {
    + 用户名 (username)
    + 邮箱 (email)
    --
    + 分配角色() (assignRole())
  }
  class Group as "Group\n组" <<Aggregate Root>> {
    + 显示名 (displayName)
  }
  class Role as "Role\n角色" <<Aggregate Root>> {
    + 角色名 (name)
  }
  class AllowPolicy as "AllowPolicy\n允许策略" <<Aggregate Root>> {
    + 语句 (statements)
  }
  class OAuthClient as "OAuthClient\nOAuth 客户端" <<Aggregate Root>> {
    + 客户端标识 (clientId)
  }
  class FederatedIdentity as "FederatedIdentity\n联邦身份" <<Entity>> {
    + 发行方 (issuer)
    + 主体 (subject)
  }
}

package "Conversational AI\n对话与智能体" <<Bounded Context>> {
  class ChatSession as "ChatSession\n聊天会话" <<Aggregate Root>> {
    + 所有者 (ownerId)
    --
    + 追加消息() (appendMessage())
  }
  class ChatMessage as "ChatMessage\n聊天消息" <<Entity>> {
    + 角色 (role)
    + 正文 (body)
  }
  class Document as "Document\n文档" <<Aggregate Root>> {
    + 标题 (title)
  }
  class Agent as "Agent\n智能体" <<Aggregate Root>> {
    + 名称 (name)
  }
  class Skill as "Skill\n技能" <<Entity>> {
    + 名称 (name)
  }
}

package "Social Messaging\n社交与即时通讯" <<Bounded Context>> {
  class Post as "Post\n动态" <<Aggregate Root>> {
    + 作者 (authorId)
    + 正文 (body)
  }
  class Conversation as "Conversation\n会话" <<Aggregate Root>> {
    + 类型 (type)
  }
  class DirectMessage as "DirectMessage\n私信" <<Entity>> {
    + 正文 (body)
  }
  class CallSession as "CallSession\n通话会话" <<Aggregate Root>> {
    + 状态 (status)
  }
}

package "Commerce\n电商交易" <<Bounded Context>> {
  class Product as "Product\n商品" <<Aggregate Root>> {
    + 名称 (name)
    + 价格 (price)
  }
  class Cart as "Cart\n购物车" <<Aggregate Root>> {
    + 所有者 (ownerId)
  }
  class Order as "Order\n订单" <<Aggregate Root>> {
    + 状态 (status)
    --
    + 提交() (submit())
  }
  class OrderLine as "OrderLine\n订单明细" <<Entity>> {
    + 数量 (quantity)
  }
  class PaymentIntent as "PaymentIntent\n支付意图" <<Aggregate Root>> {
    + 金额 (amount)
  }
}

package "ML Platform\n机器学习平台" <<Bounded Context>> {
  class ModelArtifact as "ModelArtifact\n模型制品" <<Aggregate Root>> {
    + 名称 (name)
    + 版本 (version)
  }
  class TrainingJob as "TrainingJob\n训练任务" <<Aggregate Root>> {
    + 状态 (status)
  }
  class Dataset as "Dataset\n数据集" <<Entity>> {
    + 名称 (name)
  }
  class InferenceEndpoint as "InferenceEndpoint\n推理端点" <<Aggregate Root>> {
    + 路径 (path)
  }
}

package "Wealth\n财富与投组" <<Bounded Context>> {
  class Customer as "Customer\n客户" <<Aggregate Root>> {
    + 显示名 (displayName)
  }
  class Account as "Account\n账户" <<Entity>> {
    + 币种 (currency)
  }
  class Portfolio as "Portfolio\n投资组合" <<Aggregate Root>> {
    + 名称 (name)
  }
  class Position as "Position\n持仓" <<Entity>> {
    + 数量 (quantity)
  }
  class Instrument as "Instrument\n金融工具" <<Aggregate Root>> {
    + 代码 (symbol)
  }
  class TradeOrder as "TradeOrder\n交易订单" <<Aggregate Root>> {
    + 方向 (side)
  }
}

package "Lowcode Authoring\n低代码创作" <<Bounded Context>> {
  class Page as "Page\n页面" <<Aggregate Root>> {
    + 名称 (name)
  }
  class Component as "Component\n组件" <<Entity>> {
    + 类型 (type)
  }
  class Theme as "Theme\n主题" <<Value Object>> {
    + 令牌 (tokens)
  }
  class Template as "Template\n模板" <<Aggregate Root>> {
    + 名称 (name)
  }
}

package "Visualization\n三维可视化" <<Bounded Context>> {
  class FlightRoute as "FlightRoute\n飞行航线" <<Entity>> {
    + 起点 (origin)
    + 终点 (destination)
  }
  class GeoCoord as "GeoCoord\n地理坐标" <<Value Object>> {
    + 纬度 (lat)
    + 经度 (lon)
  }
  class ThemeAppearance as "ThemeAppearance\n主题外观" <<Value Object>> {
    + 类型 (type)
  }
}

' —— 限界上下文内结构 ——
User "1" *-- "0..*" FederatedIdentity
User "0..*" -- "0..*" Role
Group "1" *-- "0..*" User
AllowPolicy "0..*" --> "0..*" Role : 绑定 / bind
OAuthClient "0..*" ..> User : 代表 / acts for

ChatSession "1" *-- "0..*" ChatMessage
Agent "1" *-- "0..*" Skill
ChatSession "0..*" --> "0..1" Document : 检索 / retrieve

Post "0..*" --> "1" User : 作者 ID
Conversation "1" *-- "0..*" DirectMessage

Order "1" *-- "0..*" OrderLine
OrderLine "0..*" --> "1" Product
Cart "0..*" --> "0..*" Product
Order "0..1" --> "0..1" PaymentIntent

TrainingJob "0..*" --> "1" Dataset
TrainingJob "0..*" --> "0..1" ModelArtifact
InferenceEndpoint "0..*" --> "1" ModelArtifact

Customer "1" *-- "0..*" Account
Portfolio "1" *-- "0..*" Position
Position "0..*" --> "1" Instrument
TradeOrder "0..*" --> "1" Instrument
Portfolio "0..*" --> "1" Customer

Page "1" *-- "0..*" Component
Page "0..*" --> "0..1" Theme
Template "0..*" --> "0..*" Page

FlightRoute --> GeoCoord : 端点 / endpoints

' —— 跨限界上下文（虚线 · 仅意图） ——
ChatSession ..> User : 所有者 ID / ownerId
Order ..> User : 下单人 ID / buyerId
Portfolio ..> User : 投资者 ID / investorId
ChatSession ..> InferenceEndpoint : 可选回路 / loopback
Post ..> Document : 可选入库 / ingest

@enduml
